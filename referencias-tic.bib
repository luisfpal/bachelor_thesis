}


@article{telloni_evolution_2021,
	title = {Evolution of {Solar} {Wind} {Turbulence} from 0.1 to 1 au during the {First} {Parker} {Solar} {Probe}–{Solar} {Orbiter} {Radial} {Alignment}},
